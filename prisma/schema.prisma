// Prisma Schema for Smart Expense Tracker & Personal Finance Intelligence Platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountType {
  SAVINGS
  CHECKING
  CREDIT_CARD
  INVESTMENT
  CASH
  LOAN
}

enum Direction {
  DEBIT
  CREDIT
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  REVERSED
  REFUNDED
  CANCELLED
}

enum TransactionType {
  EXPENSE
  INCOME
  TRANSFER
  REFUND
}

enum TransactionSource {
  BANK_SYNC
  CSV_IMPORT
  MANUAL
}

enum ConsentStatus {
  ACTIVE
  PENDING
  EXPIRED
  REVOKED
}

enum SyncStatus {
  SUCCESS
  PARTIAL
  FAILED
  SYNCING
}

enum BudgetPeriod {
  MONTHLY
  CUSTOM
}

enum RecurringFrequency {
  WEEKLY
  MONTHLY
  QUARTERLY
  ANNUALLY
}

enum RecurringStatus {
  DETECTED
  CONFIRMED
  DISMISSED
}

enum NotificationType {
  BUDGET_THRESHOLD
  SYNC_FAILURE
  RECURRING_DUE
  ANOMALY
  SYSTEM
}

model User {
  id                String              @id @default(uuid())
  email             String              @unique
  passwordHash      String
  name              String
  currency          String              @default("INR")
  googleId          String?             @unique
  avatarUrl         String?
  mfaEnabled        Boolean             @default(false)
  mfaSecret         String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  deletedAt         DateTime?

  sessions          Session[]
  bankConnections   BankConnection[]
  accounts          Account[]
  transactions      Transaction[]
  categories        Category[]
  merchantRules     MerchantRule[]
  budgets           Budget[]
  recurringPayments RecurringPayment[]
  savingsGoals      SavingsGoal[]
  notifications     Notification[]
  auditEvents       AuditEvent[]

  @@index([email])
}

model Session {
  id           String    @id @default(uuid())
  userId       String
  sessionToken String    @unique
  expiresAt    DateTime
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime  @default(now())

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionToken])
}

model Institution {
  id          String           @id @default(uuid())
  code        String           @unique
  name        String
  logo        String?
  type        String           @default("BANK")
  countryCode String           @default("IN")
  createdAt   DateTime         @default(now())

  connections BankConnection[]
}

model BankConnection {
  id                   String         @id @default(uuid())
  userId               String
  institutionId        String
  provider             String         @default("MOCK") // MOCK, ACCOUNT_AGGREGATOR, PLAID
  providerConnectionId String?
  consentStatus        ConsentStatus  @default(ACTIVE)
  consentExpiresAt     DateTime?
  lastSyncedAt         DateTime?
  syncStatus           SyncStatus     @default(SUCCESS)
  errorMessage         String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  user                 User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  institution          Institution    @relation(fields: [institutionId], references: [id])
  accounts             Account[]

  @@index([userId])
  @@index([institutionId])
}

model Account {
  id                  String           @id @default(uuid())
  userId              String
  bankConnectionId    String?
  name                String
  officialName        String?
  type                AccountType      @default(SAVINGS)
  accountNumberMasked String?
  currency            String           @default("INR")
  currentBalance      Decimal          @default(0.00) @db.Decimal(14, 2)
  availableBalance    Decimal          @default(0.00) @db.Decimal(14, 2)
  isActive            Boolean          @default(true)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  user                User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  bankConnection      BankConnection?  @relation(fields: [bankConnectionId], references: [id], onDelete: SetNull)
  transactions        Transaction[]
  recurringPayments   RecurringPayment[]

  @@index([userId])
  @@index([bankConnectionId])
}

model Category {
  id                String             @id @default(uuid())
  userId            String?            // Null if system-wide category
  name              String
  slug              String
  icon              String?
  color             String?
  parentId          String?
  isSystem          Boolean            @default(true)
  type              TransactionType    @default(EXPENSE)
  createdAt         DateTime           @default(now())

  user              User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent            Category?          @relation("CategoryHierarchy", fields: [parentId], references: [id])
  subcategories     Category[]         @relation("CategoryHierarchy")
  transactions      Transaction[]      @relation("PrimaryCategory")
  subTransactions   Transaction[]      @relation("SubCategory")
  budgets           Budget[]
  merchantRules     MerchantRule[]

  @@index([userId])
  @@index([slug])
  @@index([parentId])
}

model Transaction {
  id                    String            @id @default(uuid())
  userId                String
  accountId             String
  providerTransactionId String?
  fingerprint           String
  amount                Decimal           @db.Decimal(14, 2)
  currency              String            @default("INR")
  direction             Direction
  status                TransactionStatus @default(COMPLETED)
  type                  TransactionType   @default(EXPENSE)
  date                  DateTime
  bookingDate           DateTime?
  originalDescription   String
  normalizedMerchant    String
  categoryId            String?
  subcategoryId         String?
  aiConfidence          Float             @default(1.0)
  isReviewed            Boolean           @default(false)
  isTransfer            Boolean           @default(false)
  linkedTransactionId   String?
  notes                 String?
  tags                  String            @default("[]") // JSON string of string tags
  source                TransactionSource @default(BANK_SYNC)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  user                  User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  account               Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  category              Category?         @relation("PrimaryCategory", fields: [categoryId], references: [id], onDelete: SetNull)
  subcategory           Category?         @relation("SubCategory", fields: [subcategoryId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([accountId])
  @@index([date])
  @@index([categoryId])
  @@index([fingerprint])
  @@index([normalizedMerchant])
}

model MerchantRule {
  id             String    @id @default(uuid())
  userId         String
  pattern        String    // Regex or keyword pattern
  normalizedName String
  categoryId     String
  priority       Int       @default(100)
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())

  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category       Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([pattern])
}

model Budget {
  id                    String       @id @default(uuid())
  userId                String
  categoryId            String
  amount                Decimal      @db.Decimal(14, 2)
  period                BudgetPeriod @default(MONTHLY)
  startDate             DateTime
  endDate               DateTime?
  rollover              Boolean      @default(false)
  alertThresholds       String       @default("[50, 75, 90, 100]") // JSON array
  lastAlertedThreshold  Int?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  user                  User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  category              Category     @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([categoryId])
}

model RecurringPayment {
  id               String             @id @default(uuid())
  userId           String
  accountId        String
  merchantName     String
  amount           Decimal            @db.Decimal(14, 2)
  frequency        RecurringFrequency @default(MONTHLY)
  status           RecurringStatus    @default(DETECTED)
  lastDate         DateTime
  nextExpectedDate DateTime
  categoryId       String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  account          Account            @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([accountId])
}

model SavingsGoal {
  id            String    @id @default(uuid())
  userId        String
  name          String
  targetAmount  Decimal   @db.Decimal(14, 2)
  currentAmount Decimal   @default(0.00) @db.Decimal(14, 2)
  targetDate    DateTime
  color         String?   @default("#059669")
  icon          String?   @default("target")
  isCompleted   Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType @default(SYSTEM)
  title     String
  message   String
  link      String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
}

model AuditEvent {
  id        String   @id @default(uuid())
  userId    String
  action    String
  ipAddress String?
  userAgent String?
  details   String   @default("{}") // JSON
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([action])
}
