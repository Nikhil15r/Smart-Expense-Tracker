# ==============================================================================
# Smart Expense Tracker & Personal Finance Intelligence Platform
# Environment Configuration Template
# ==============================================================================

# Database Connection (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Example cloud providers: Neon (neon.tech), Supabase (supabase.com), Railway, or local Postgres
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/smart_expense_tracker?schema=public"

# Authentication & Security
# Generate a strong 32+ char secret in terminal: openssl rand -base64 32
JWT_SECRET="replace-with-a-very-secure-random-32-character-secret"
COOKIE_NAME="finance_session"

# Google OAuth 2.0 Authentication (Optional for Live Production)
# Obtain from Google Cloud Console (https://console.cloud.google.com/apis/credentials):
# 1. Create an OAuth 2.0 Client ID (Web Application)
# 2. Add Authorized JavaScript origin: http://localhost:3000
# 3. Add Authorized Redirect URI: http://localhost:3000/api/auth/google/callback
# Note: When left empty, the application runs in a sandbox mode allowing instant 1-click Google testing!
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Application Settings
NEXT_PUBLIC_APP_NAME="Smart Expense Tracker"
NEXT_PUBLIC_DEFAULT_CURRENCY="INR"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional External Bank Provider Credentials (for Live Account Aggregator / Plaid)
# Note: Initial application uses the fully interactive isolated MockBankDataProvider
BANK_PROVIDER_MODE="mock" # "mock" | "account_aggregator" | "plaid"
SETU_CLIENT_ID=""
SETU_CLIENT_SECRET=""
SETU_PRODUCT_INSTANCE_ID=""
PLAID_CLIENT_ID=""
PLAID_SECRET=""
PLAID_ENV="sandbox"

# Optional AI Categorization & Insights API (e.g. OpenAI / Anthropic / Gemini)
# Deterministic rule engine & analytical query engine run fully offline without any key
AI_PROVIDER=""
AI_API_KEY=""
